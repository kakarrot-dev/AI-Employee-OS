{
  "name": "ai-employee-os-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive macOS client design prototype with local mock data",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "26.8.1",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run check:boundary && npm run typecheck && electron-vite build",
    "package:local": "npm run build && node scripts/package_local_app.mjs",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "prototype:check:typography": "node prototypes/macos-client-v2/scripts/check-typography-contract.mjs",
    "prototype:check:layout": "node prototypes/macos-client-v2/scripts/check-layout-contract.mjs",
    "check:boundary": "node scripts/check_prototype_boundary.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.0.0",
    "electron-vite": "5.0.0",
    "iconoir-react": "7.12.1",
    "jsdom": "30.0.1",
    "react-aria-components": "1.20.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
