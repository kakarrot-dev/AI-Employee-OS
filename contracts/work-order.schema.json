{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkOrderProjection",
  "type": "object", "additionalProperties": false,
  "required": ["id", "business_flow_id", "node_id", "child_task_id", "assignee_agent_id", "role", "goal", "status", "revision", "dependency_ids"],
  "properties": {
    "id": {"type": "string", "pattern": "^flow_[a-z0-9_-]{8,64}:work:[a-z0-9_-]+$"},
    "business_flow_id": {"type": "string", "pattern": "^flow_[a-z0-9_-]{8,64}$"},
    "node_id": {"type": "string", "minLength": 1},
    "child_task_id": {"type": "string", "minLength": 1},
    "assignee_agent_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["coordinator", "executor", "finalization"]},
    "goal": {"type": "string", "minLength": 1, "maxLength": 8000},
    "status": {"enum": ["ready", "waiting_dependency", "waiting_user", "waiting_approval", "verification_required", "pending", "running", "succeeded", "failed", "cancelled"]},
    "revision": {"type": "integer", "minimum": 1},
    "dependency_ids": {"type": "array", "maxItems": 11, "uniqueItems": true, "items": {"type": "string", "pattern": "^flow_[a-z0-9_-]{8,64}:work:[a-z0-9_-]+$"}}
  }
}
