{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-employee-os.local/contracts/task-room-timeline.schema.json",
  "title": "TaskRoomTimeline",
  "type": "object",
  "required": ["schema_version", "thread_id", "participants", "items"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "thread_id": {"type": "string", "minLength": 1},
    "participants": {"type": "array", "items": {"$ref": "#/$defs/participant"}},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "participant": {
      "type": "object",
      "required": ["agent_id", "name", "role", "avatar_path", "status"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "avatar_path": {"type": ["string", "null"]},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["id", "sequence", "role", "kind", "content", "created_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "role": {"enum": ["user", "system", "agent"]},
        "kind": {"enum": ["goal", "clarification", "proposal", "confirmation", "agent_update", "activity", "approval", "handoff", "progress", "deliverable", "error"]},
        "content": {"type": "string"},
        "created_at": {"type": "string", "minLength": 1},
        "agent_id": {"type": ["string", "null"]},
        "agent_name": {"type": ["string", "null"]},
        "agent_role": {"type": ["string", "null"]},
        "avatar_path": {"type": ["string", "null"]},
        "task_id": {"type": ["string", "null"]},
        "run_id": {"type": ["string", "null"]},
        "action_id": {"type": ["string", "null"]},
        "approval_id": {"type": ["string", "null"]},
        "handoff_id": {"type": ["string", "null"]},
        "deliverable_id": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "tool_id": {"type": ["string", "null"]},
        "action": {"type": ["string", "null"]},
        "artifact_uri": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
