{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-employee-os.local/contracts/skill-manifest.schema.json",
  "title": "SkillManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description", "category", "runtime_compatibility", "status", "entrypoint", "triggers", "required_context", "optional_context", "required_tools", "input_schema", "output_schema", "artifact_types", "workflow", "completion", "evaluation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "description": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "runtime_compatibility": {"type": "string", "minLength": 1},
        "status": {"enum": ["active", "disabled"]},
        "entrypoint": {"type": "string", "minLength": 1},
        "triggers": {"type": "object"},
        "required_context": {"type": "array", "items": {"type": "object"}},
        "optional_context": {"type": "array", "items": {"type": "object"}},
        "required_tools": {"type": "array", "items": {"type": "object"}},
        "input_schema": {"type": "object"},
        "output_schema": {"type": "object"},
        "artifact_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "max_steps", "steps"],
          "properties": {
            "engine": {"const": "runtime-dag-v1"},
            "max_steps": {"type": "integer", "minimum": 1},
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "depends_on", "input_from", "output_as", "timeout_ms", "retry_policy", "on_failure"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                  "input_from": {"type": "array", "items": {"type": "string"}},
                  "output_as": {"type": "string", "minLength": 1},
                  "tool": {"type": "object"},
                  "approval": {"type": "string"},
                  "timeout_ms": {"type": "integer", "minimum": 1},
                  "retry_policy": {"type": "object"},
                  "on_failure": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "completion": {"type": "object"},
        "evaluation": {"type": "object"}
      }
    }
  }
}
