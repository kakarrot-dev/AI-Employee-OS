{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ai-employee-os.local/contracts/skill-manifest.schema.json",
  "title":"SkillManifestV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","skill"],
  "properties":{
    "schema_version":{"const":"2.0.0"},
    "skill":{
      "type":"object","additionalProperties":false,
      "required":["id","name","version","description","category","runtime_compatibility","status","instructions","routing","context","tools","input_schema","output_schema","execution","deliverables","evaluation"],
      "properties":{
        "id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},
        "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "description":{"type":"string","minLength":1},"category":{"type":"string","minLength":1},
        "runtime_compatibility":{"type":"string","minLength":1},"status":{"enum":["active","disabled"]},
        "instructions":{"type":"string","minLength":1},
        "routing":{"type":"object"},"context":{"type":"object"},
        "tools":{"type":"array","items":{"type":"object"}},
        "input_schema":{"type":"object"},"output_schema":{"type":"object"},
        "execution":{
          "type":"object","additionalProperties":false,
          "required":["mode","max_model_turns","max_tool_calls","max_duration_ms","on_result_unknown"],
          "properties":{
            "mode":{"enum":["agent_loop","workflow"]},"max_model_turns":{"type":"integer","minimum":1},
            "max_tool_calls":{"type":"integer","minimum":0},"max_duration_ms":{"type":"integer","minimum":1},
            "on_result_unknown":{"const":"stop"},"workflow":{"type":"string","minLength":1}
          }
        },
        "deliverables":{"type":"object"},"evaluation":{"type":"object"}
      }
    }
  }
}
