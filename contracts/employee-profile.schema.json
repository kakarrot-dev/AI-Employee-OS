{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-employee-os.local/contracts/employee-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "role", "department", "mission", "responsibilities", "boundaries", "soul", "persona", "base_prompt", "status", "config_version"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]{2,63}"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "role": {"type": "string", "minLength": 1, "maxLength": 120},
    "department": {"type": "string", "minLength": 1, "maxLength": 80},
    "mission": {"type": "string", "minLength": 1, "maxLength": 500},
    "responsibilities": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "maxItems": 20},
    "boundaries": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "maxItems": 20},
    "soul": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "maxItems": 20},
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["communication", "thinking", "decision", "habit"],
      "properties": {
        "communication": {"type": "object"}, "thinking": {"type": "object"},
        "decision": {"type": "object"}, "habit": {"type": "object"}
      }
    },
    "base_prompt": {"type": "string", "minLength": 1, "maxLength": 8000},
    "avatar_path": {"type": ["string", "null"], "minLength": 1},
    "status": {"enum": ["active", "disabled"]},
    "config_version": {"type": "integer", "minimum": 1}
  }
}
