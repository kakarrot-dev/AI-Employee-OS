{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BusinessFlowStatus",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "business_flow_id", "root_task_id", "scenario_id", "scenario_version_id", "scenario_sha256", "title", "objective", "status", "root_deliverable_id", "work_orders"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "business_flow_id": {"type": "string", "minLength": 1},
    "root_task_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "scenario_version_id": {"type": "string", "minLength": 1},
    "scenario_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "running", "succeeded", "failed", "cancelled"]},
    "root_deliverable_id": {"type": ["string", "null"]},
    "work_orders": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"type": "object"}}
  }
}
