{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-employee-os.local/contracts/tool-manifest.schema.json",
  "title": "ToolManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description", "type", "runtime", "entrypoint", "actions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "description": {"type": "string", "minLength": 1},
        "type": {"enum": ["native", "mcp", "plugin"]},
        "runtime": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "input_schema", "output_schema", "required_permissions", "risk_level", "side_effect", "confirmation", "timeout_ms", "idempotency", "concurrency_safe", "retry_policy", "result_size_limit", "sensitive_fields", "verification"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "input_schema": {"type": "object"},
              "output_schema": {"type": "object"},
              "required_permissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "risk_level": {"type": "integer", "minimum": 0, "maximum": 3},
              "side_effect": {"enum": ["none", "reversible", "irreversible"]},
              "confirmation": {"enum": ["never", "on_risk", "always"]},
              "timeout_ms": {"type": "integer", "minimum": 1},
              "idempotency": {"enum": ["safe", "keyed", "unsafe"]},
              "concurrency_safe": {"type": "boolean"},
              "retry_policy": {
                "type": "object",
                "additionalProperties": false,
                "required": ["max_attempts", "retry_on"],
                "properties": {
                  "max_attempts": {"type": "integer", "minimum": 1},
                  "retry_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
                }
              },
              "result_size_limit": {"type": "integer", "minimum": 1},
              "sensitive_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "verification": {"enum": ["none", "required"]}
            }
          }
        }
      }
    }
  }
}
