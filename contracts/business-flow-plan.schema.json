{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BusinessFlowPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "scenario_version_id", "plan_hash", "execution_order", "work_orders", "blocking_issues"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scenario_id": {"type": "string", "minLength": 1},
    "scenario_version_id": {"type": "string", "minLength": 1},
    "plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_order": {"type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "work_orders": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"type": "object"}},
    "blocking_issues": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "work_order": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "assignee_agent_id", "role", "dependency_ids", "budget"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "assignee_agent_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["coordinator", "executor", "finalization"]},
        "dependency_ids": {"type": "array", "maxItems": 11, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "budget": {"type": "object"}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_input_tokens", "max_output_tokens", "max_tool_rounds", "max_elapsed_ms"],
      "properties": {
        "max_input_tokens": {"type": "integer", "minimum": 1, "maximum": 200000},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 64000},
        "max_tool_rounds": {"type": "integer", "minimum": 0, "maximum": 32},
        "max_elapsed_ms": {"type": "integer", "minimum": 1, "maximum": 3600000}
      }
    }
  }
}
