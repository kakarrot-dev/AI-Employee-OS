{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-employee-os.local/contracts/validated-task-proposal.schema.json",
  "title": "ValidatedTaskProposal",
  "type": "object",
  "required": ["schema_version", "proposal_id", "thread_id", "revision", "proposal_hash", "expires_at", "requires_confirmation", "resolved_assignments", "proposal"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "proposal_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "proposal_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expires_at": {"type": "string", "pattern": "^[0-9]+$"},
    "requires_confirmation": {"const": true},
    "resolved_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "agent_id", "skill_ids"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "agent_id": {"type": "string", "minLength": 1},
          "skill_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "proposal": {"$ref": "task-proposal.schema.json"}
  },
  "additionalProperties": false
}
