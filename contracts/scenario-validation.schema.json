{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-employee-os.local/contracts/scenario-validation.schema.json",
  "title": "ScenarioValidation",
  "type": "object",
  "required": ["schema_version", "valid", "proposal_hash", "issues", "normalized_proposal"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "valid": {"type": "boolean"},
    "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "path", "message"],
        "properties": {
          "severity": {"enum": ["blocking", "warning"]},
          "code": {"type": "string", "minLength": 1},
          "path": {"type": "string"},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "normalized_proposal": {"$ref": "scenario-proposal.schema.json"}
  },
  "additionalProperties": false
}
