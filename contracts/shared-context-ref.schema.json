{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SharedContextRef",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "business_flow_id", "source_type", "source_id", "sensitivity", "allowed_agents", "content_sha256", "added_by"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "business_flow_id": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["user_input", "knowledge", "artifact", "deliverable"]},
    "source_id": {"type": "string", "minLength": 1},
    "sensitivity": {"enum": ["public", "internal", "sensitive"]},
    "allowed_agents": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "added_by": {"type": "string", "minLength": 1}
  }
}
