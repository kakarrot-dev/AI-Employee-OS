{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-employee-os.local/contracts/task-proposal.schema.json",
  "title": "TaskProposal",
  "type": "object",
  "required": ["schema_version", "intent", "title", "objective", "missing_inputs", "deliverable", "assignments", "acceptance_criteria", "requested_resources", "budget_hint"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "intent": {"enum": ["chat", "single_agent_task", "multi_agent_task"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "objective": {"type": "string", "minLength": 1, "maxLength": 8000},
    "missing_inputs": {"type": "array", "maxItems": 12, "items": {"type": "object", "required": ["key", "question", "required"], "properties": {"key": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}}, "additionalProperties": false}},
    "deliverable": {"type": "object", "required": ["type", "description", "target_path"], "properties": {"type": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "target_path": {"type": ["string", "null"]}}, "additionalProperties": false},
    "assignments": {"type": "array", "maxItems": 12, "items": {"type": "object", "required": ["node_id", "role", "employee_selector", "goal", "depends_on", "acceptance_criteria"], "properties": {"node_id": {"type": "string", "minLength": 1}, "role": {"enum": ["owner", "contributor", "finalizer"]}, "employee_selector": {"type": "object", "required": ["preferred_id", "capabilities"], "properties": {"preferred_id": {"type": ["string", "null"]}, "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}, "additionalProperties": false}, "goal": {"type": "string", "minLength": 1}, "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "acceptance_criteria": {"$ref": "#/$defs/acceptanceCriteria"}}, "additionalProperties": false}},
    "acceptance_criteria": {"$ref": "#/$defs/acceptanceCriteria"},
    "requested_resources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "budget_hint": {"type": "object", "required": ["input_tokens", "output_tokens", "tool_rounds", "wall_clock_ms"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "tool_rounds": {"type": "integer", "minimum": 0}, "wall_clock_ms": {"type": "integer", "minimum": 0}}, "additionalProperties": false}
  },
  "$defs": {"acceptanceCriteria": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "required": ["criterion_id", "description", "evidence_type", "required"], "properties": {"criterion_id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "evidence_type": {"enum": ["structured_output", "artifact", "tool_result", "evaluation"]}, "required": {"type": "boolean"}}, "additionalProperties": false}}},
  "additionalProperties": false
}
