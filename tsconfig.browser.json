{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "composite": false,
    "resolveJsonModule": true
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/runtime-contract.ts",
    "src/shared/employee-contract.ts",
    "src/shared/expert-group-contract.ts",
    "src/shared/supervisor-contract.ts",
    "src/shared/task-contract.ts",
    "src/shared/chat-content-contract.ts",
    "src/shared/resource-contract.ts",
    "src/shared/memory-contract.ts",
    "src/shared/usage-contract.ts",
    "src/shared/capability-contract.ts",
    "src/shared/feishu-meeting-contract.ts",
    "src/web/**/*.ts",
    "src/web/**/*.tsx"
  ]
}
